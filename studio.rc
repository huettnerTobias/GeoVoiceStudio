#pragma code_page(65001)
#include <windows.h>
#include "studio_ui.h"
LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
1 RT_MANIFEST "studio.manifest"
ID_FILE_MENU MENU
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "Routenpaket &importieren…\tStrg+O", ID_FILE_IMPORT
        MENUITEM "Bestehende Java-&Bibliothek übernehmen…", ID_FILE_LEGACY
        MENUITEM SEPARATOR
        MENUITEM "Gewählte Route &exportieren…\tStrg+E", ID_FILE_EXPORT
        MENUITEM "Alle Routen als Paket exportieren…", ID_ALL_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Beenden", ID_EXIT
    END
    POPUP "&Route"
    BEGIN
        MENUITEM "&Neue Route…\tStrg+N", ID_ROUTE_NEW
        MENUITEM "Route &umbenennen…", ID_ROUTE_RENAME
        MENUITEM "Route &löschen…", ID_ROUTE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Punkt hinzufügen…\tStrg+P", ID_POINT_NEW
        MENUITEM "Punkt bearbeiten…", ID_POINT_EDIT
        MENUITEM "Punkt entfernen…", ID_POINT_DELETE
    END
    POPUP "&Karte"
    BEGIN
        MENUITEM "&Offlinekarten verwalten…", ID_MAPS
        MENUITEM "&Ganze Route anzeigen", ID_FIT
        MENUITEM "Routen&linie anzeigen", ID_LINE, CHECKED
        MENUITEM "Punkt&namen anzeigen", ID_NAMES, CHECKED
    END
    POPUP "&Werkzeuge"
    BEGIN
        MENUITEM "&Audiobibliothek…", ID_LIBRARY
        MENUITEM SEPARATOR
        MENUITEM "&Zugangscodes verwalten…", ID_SECURITY
        MENUITEM "Bearbeitung &sperren", ID_LOCK
    END
    MENUITEM "&Hilfe", ID_ABOUT
END
ID_KEYS ACCELERATORS
BEGIN
    "N", ID_ROUTE_NEW, VIRTKEY, CONTROL
    "O", ID_FILE_IMPORT, VIRTKEY, CONTROL
    "E", ID_FILE_EXPORT, VIRTKEY, CONTROL
    "P", ID_POINT_NEW, VIRTKEY, CONTROL
    VK_F1, ID_ABOUT, VIRTKEY
END
ID_NAME_DLG DIALOGEX 0,0,280,87
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", ID_PROMPT,12,10,256,12
    EDITTEXT ID_VALUE,12,25,256,16,ES_AUTOHSCROLL
    DEFPUSHBUTTON "Speichern",IDOK,125,58,67,18
    PUSHBUTTON "Abbrechen",IDCANCEL,198,58,70,18
END
ID_POINT_DLG DIALOGEX 0,0,322,191
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Routenpunkt"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Punktname", -1,12,11,210,11
    EDITTEXT ID_VALUE,12,24,298,16,ES_AUTOHSCROLL
    LTEXT "&Breitengrad (−90 bis 90)",-1,12,49,140,11
    EDITTEXT ID_LAT,12,62,144,16,ES_AUTOHSCROLL
    LTEXT "&Längengrad (−180 bis 180)",-1,166,49,145,11
    EDITTEXT ID_LON,166,62,144,16,ES_AUTOHSCROLL
    LTEXT "&Ansage (WAV oder MP3)",-1,12,89,237,11
    COMBOBOX ID_AUDIO,12,102,298,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Audio importieren…",ID_ADD_AUDIO,12,126,100,18
    PUSHBUTTON "Anhören",ID_PLAY,119,126,65,18
    DEFPUSHBUTTON "Speichern",IDOK,167,161,68,18
    PUSHBUTTON "Abbrechen",IDCANCEL,241,161,69,18
END
ID_AUDIO_DLG DIALOGEX 0,0,340,207
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Audiobibliothek"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Audiodateien", -1,12,10,185,12
    LISTBOX ID_AUDIO,12,25,203,141,LBS_NOTIFY | LBS_SORT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "Dateien importieren…",ID_ADD_AUDIO,224,25,104,18
    PUSHBUTTON "Anhören",ID_PLAY,224,52,104,18
    PUSHBUTTON "Stopp",ID_STOP,224,75,104,18
    PUSHBUTTON "Umbenennen…",ID_AUDIO_RENAME,224,105,104,18
    PUSHBUTTON "Löschen…",ID_AUDIO_DELETE,224,128,104,18
    DEFPUSHBUTTON "Schließen",IDOK,255,178,73,18
END
ID_SECURITY_DLG DIALOGEX 0,0,284,137
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Zugangscodes für dieses Studio"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Das Admin-Passwort schützt die Einrichtung. Der Route-Code schaltet das Bearbeiten frei.",-1,12,10,260,23
    LTEXT "&Admin-Passwort",-1,12,43,100,12
    EDITTEXT ID_ADMIN,117,40,155,16,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "&Route-Code",-1,12,68,100,12
    EDITTEXT ID_CODE,117,65,155,16,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Beide Zugangsdaten bleiben auf diesem PC.",-1,12,86,258,12
    DEFPUSHBUTTON "Speichern",IDOK,125,108,70,18
    PUSHBUTTON "Abbrechen",IDCANCEL,201,108,71,18
END
ID_UNLOCK_DLG DIALOGEX 0,0,260,76
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bearbeitung freischalten"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Route-Code",ID_PROMPT,12,9,236,10
    EDITTEXT ID_VALUE,12,22,236,16,ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON "Bestätigen",IDOK,105,48,68,18
    PUSHBUTTON "Abbrechen",IDCANCEL,179,48,69,18
END
206 DIALOGEX 0,0,289,60
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "GeoVoice Studio"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Routenpaket",ID_PROMPT,12,12,265,15
    CONTROL "",ID_INFO,"msctls_progress32",0x00000008,12,33,265,10
END
601 RCDATA "vendor/miniz/LICENSE"
602 RCDATA "vendor/yyjson/LICENSE"
